{
  "name": "umber-backend",
  "version": "0.1.0",
  "description": "Umber backend API - contemplative commerce platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node test-api.js",
    "test:jest": "jest",
    "test:watch": "jest --watch",
    "test:scraping": "node -e \"const UrlScrapingService = require('./src/services/urlScrapingService'); const service = new UrlScrapingService(); service.testScraping();\"",
    "db:setup": "node -e \"console.log('Make sure MongoDB is running on localhost:27017')\""
  },
  "keywords": [
    "umber",
    "wishlist",
    "mindful",
    "commerce"
  ],
  "author": "Umber Team",
  "license": "MIT",
  "dependencies": {
    "@microlink/mql": "^0.10.0",
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.1.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^6.14.3",
    "helmet": "^6.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.8.7",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
